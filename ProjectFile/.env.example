# Optional for a local demo; required by compose.yaml for a shared deployment.
ADMIN_PASSWORD=

# Keep both directories on a persistent Azure disk or Docker volume.
# RAG_DATA_DIR=/absolute/path/to/data
# RAG_MODEL_DIR=/absolute/path/to/models

RAG_THREADS=2
RAG_CONTEXT_TOKENS=4096
RAG_ANSWER_TOKENS=256
RAG_TOP_K=4
# Tune on evaluation questions. Similarity is not a calibrated confidence score.
RAG_MIN_SIMILARITY=0.45

# Optional HTTPS deployment on an Azure VM:
# APP_DOMAIN=chat.example.edu
# APP_MEMORY_LIMIT=6g
# APP_CPUS=2

# Optional alternative folder for Markdown assignment schedules:
# ASSIGNMENTS_DIR=/absolute/path/to/assignments
